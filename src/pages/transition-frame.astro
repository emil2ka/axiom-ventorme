<!doctype html>
<html lang="ru">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Ventorme — transition reference without characters</title>
<style is:global>
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#fafbfc}.frame{position:relative;width:100vw;height:100vh;overflow:hidden;background:radial-gradient(ellipse at 72% 45%,#eef6ff 0%,#fafcfe 60%,#fafbfc 100%)}.environment{position:absolute;display:block;user-select:none}
</style></head>
<body><main class="frame" aria-label="Кадр окружения без персонажей"><img class="environment" src="/map-islands/university-polished.png" alt="Пиксельный остров без персонажей"/></main>
<script>
const worlds=['direction','university','preparation','funding','application'];
const query=new URLSearchParams(location.search),requested=query.get('world')??'university';const key=worlds.includes(requested)?requested:'university';const inside=query.get('view')==='inside';
const image=document.querySelector<HTMLImageElement>('.environment')!,frame=document.querySelector<HTMLElement>('.frame')!;
image.src=inside?`/islands/${key}-refined.png`:`/map-islands/${key}-polished.png`;
function layout(){const width=inside?Math.min(innerWidth*1.25,innerHeight*2,1600):Math.min(560,innerWidth*.65,innerHeight*.78);const height=width*(inside?941/1672:1),left=(innerWidth-width)/2,top=inside?innerHeight*.47-height*.4:(innerHeight-height)/2;Object.assign(image.style,{width:`${width}px`,height:`${height}px`,left:`${left}px`,top:`${top}px`});}
image.decode().then(()=>{layout();frame.dataset.ready='true';});window.addEventListener('resize',layout);layout();
</script>
</body></html>
