---
import SelectionSummary from './SelectionSummary';
import RegistrationLink from './RegistrationLink.astro';
---

<section id="ventorme" class="section features" aria-labelledby="ventorme-title">
  <div class="container">
    <div class="section-head">
      <h2 class="h2" id="ventorme-title">Интерес появился. Как двигаться дальше?</h2>
      <p class="lead">
        Ventorme — платформа для выбора профессии и поступления: интересы, варианты учёбы и
        подготовка в одном месте.
      </p>
    </div>
    <div class="features-grid">
      <aside class="features-panel" aria-labelledby="features-panel-title">
        <h3 class="features-panel-title" id="features-panel-title">Твой маршрут на этой странице</h3>
        <SelectionSummary client:visible />
      </aside>
      <div class="features-list">
        <article class="feature">
          <p class="feature-num" aria-hidden="true">01</p>
          <div class="feature-body">
            <h3 class="feature-title">Разобраться в интересах</h3>
            <p class="feature-text">
              Посмотреть, какие занятия и профессии связаны с твоими интересами.
            </p>
          </div>
        </article>
        <article class="feature">
          <p class="feature-num" aria-hidden="true">02</p>
          <div class="feature-body">
            <h3 class="feature-title">Изучить варианты учёбы</h3>
            <p class="feature-text">
              Подбор вузов и ориентиры по грантам — актуальные данные и условия в самом Ventorme.
            </p>
          </div>
        </article>
        <article class="feature">
          <p class="feature-num" aria-hidden="true">03</p>
          <div class="feature-body">
            <h3 class="feature-title">Понять подготовку</h3>
            <p class="feature-text">
              Инструменты подготовки к экзаменам. Конкретные возможности и условия — на платформе.
            </p>
          </div>
        </article>
        <div class="features-cta">
          <RegistrationLink variant="primary" placement="features" />
          <p class="micro">Откроется Ventorme. Создай аккаунт и заверши начальную настройку.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    gap: clamp(32px, 5vw, 48px);
  }

  .features-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3vw, 32px);
  }

  .features-panel :global(astro-island) {
    display: block;
    width: 100%;
  }

  .features-panel-title {
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .features-list {
    display: grid;
    align-content: start;
  }

  .feature {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 4px 16px;
    padding-block: clamp(20px, 3vw, 28px);
    border-top: 1px solid var(--border);
  }

  .feature:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .feature-num {
    padding-top: 4px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  .feature-title {
    font-size: clamp(19px, 2vw, 23px);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .feature-text {
    margin-top: 8px;
    color: var(--text-muted);
    max-width: 52ch;
  }

  .features-cta {
    display: grid;
    justify-items: start;
    gap: 12px;
    margin-top: clamp(28px, 4vw, 40px);
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(40px, 5vw, 72px);
      align-items: start;
    }
  }
</style>
