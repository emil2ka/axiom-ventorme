---
import RegistrationLink from './RegistrationLink.astro';
---

<section id="final" class="section final" data-final aria-labelledby="final-title">
  <div class="container final-inner">
    <h2 class="h2 final-title" id="final-title">
      Не нужно решать всё сегодня. Начни с одного шага.
    </h2>
    <div class="final-portal" aria-hidden="true">
      <svg class="portal-svg" viewBox="0 0 720 520" role="presentation" focusable="false">
        <defs>
          <radialGradient id="final-portal-light" cx="50%" cy="50%" r="50%">
            <stop class="portal-stop portal-stop--core" offset="0" />
            <stop class="portal-stop portal-stop--mid" offset="0.45" />
            <stop class="portal-stop portal-stop--edge" offset="1" />
          </radialGradient>
        </defs>
        <g fill="none" stroke-linecap="round">
          <path class="portal-arc portal-arc--3" d="M 40 408 A 320 320 0 0 1 680 408" />
          <path class="portal-arc portal-arc--2" d="M 120 408 A 240 240 0 0 1 600 408" />
          <path class="portal-arc portal-arc--1" d="M 200 408 A 160 160 0 0 1 520 408" />
        </g>
        <circle class="portal-core" cx="360" cy="408" r="150" />
        <circle class="portal-dot" cx="360" cy="408" r="3" />
      </svg>
    </div>
    <div class="final-action">
      <p class="lead">
        Познакомься с Ventorme и его возможностями для выбора профессии и поступления.
      </p>
      <RegistrationLink variant="primary" placement="finale" />
      <p class="micro">Регистрация откроется на ventorme.ai</p>
    </div>
  </div>
</section>

<style>
  .final {
    --final-glow: var(--accent);
    position: relative;
    overflow: clip;
  }

  .final[data-cat='technology'] {
    --final-glow: var(--cat-technology);
  }

  .final[data-cat='creativity'] {
    --final-glow: var(--cat-creativity);
  }

  .final[data-cat='research'] {
    --final-glow: var(--cat-research);
  }

  .final[data-cat='people'] {
    --final-glow: var(--cat-people);
  }

  .final[data-cat='organization'] {
    --final-glow: var(--cat-organization);
  }

  .final-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: clamp(20px, 3vw, 30px);
    text-align: center;
  }

  .final-title {
    max-width: 24ch;
  }

  .final-action {
    display: grid;
    justify-items: center;
    gap: 14px;
  }

  .final-action .lead {
    max-width: 52ch;
  }

  .final-portal {
    width: 100%;
  }

  .portal-svg {
    width: 100%;
    height: auto;
    max-height: 300px;
    margin-inline: auto;
  }

  .portal-arc {
    stroke: var(--final-glow);
    stroke-width: 1.2;
  }

  .portal-arc--3 {
    opacity: 0.16;
  }

  .portal-arc--2 {
    opacity: 0.28;
  }

  .portal-arc--1 {
    opacity: 0.45;
  }

  .portal-stop {
    stop-color: var(--final-glow);
  }

  .portal-stop--core {
    stop-opacity: 0.55;
  }

  .portal-stop--mid {
    stop-opacity: 0.18;
  }

  .portal-stop--edge {
    stop-opacity: 0;
  }

  .portal-core {
    fill: url(#final-portal-light);
    animation: portal-breathe 7s var(--ease-inout) infinite;
  }

  .portal-dot {
    fill: var(--text);
    opacity: 0.9;
  }

  @keyframes portal-breathe {
    0%,
    100% {
      opacity: 0.85;
    }

    50% {
      opacity: 1;
    }
  }

  @media (min-width: 768px) {
    .final-inner {
      min-height: clamp(460px, 60vh, 620px);
      align-content: center;
    }

    .final-portal {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: -1;
      width: min(860px, 92%);
      transform: translate(-50%, -54%);
    }

    .portal-svg {
      max-height: none;
    }
  }
</style>

<script>
  import { CATEGORY_ORDER } from '../data/categories';
  import * as questions from '../data/questions';
  import { loadJourney } from '../lib/session';

  try {
    const section = document.querySelector('[data-final]');
    if (section) {
      const journey = loadJourney();
      const interestIds = journey?.answers?.interestIds ?? [];
      const categoryById = new Map();

      for (const value of Object.values(questions)) {
        if (!Array.isArray(value)) continue;
        for (const item of value) {
          if (
            item &&
            typeof item === 'object' &&
            typeof item.id === 'string' &&
            typeof item.category === 'string'
          ) {
            categoryById.set(item.id, item.category);
          }
        }
      }

      const category = CATEGORY_ORDER.find((id) =>
        interestIds.some((interestId) => categoryById.get(interestId) === id),
      );

      if (category) section.setAttribute('data-cat', category);
    }
  } catch (error) {}
</script>
