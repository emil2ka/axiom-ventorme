---
import FutureAtlas from './scene/FutureAtlas.tsx';
import { registrationUrl } from '../config/campaign';

const reg = registrationUrl();
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-enter hero-enter--1">ПРОФЕССИЯ · УЧЁБА · СЛЕДУЮЩИЙ ШАГ</p>
      <h1 id="hero-title" class="h1 hero-title hero-enter hero-enter--2">
        Твой интерес — начало пути.
      </h1>
      <p class="lead hero-lead hero-enter hero-enter--3">
        Познакомься с направлениями, которые тебе близки, и&nbsp;узнай, как двигаться дальше с
        Ventorme
      </p>
    </div>

    <div class="hero-stage hero-enter hero-enter--4">
      <FutureAtlas client:visible />
    </div>

    <div class="hero-actions hero-enter hero-enter--5">
      <div class="cta-row">
        <a class="btn btn--primary" href="#interests" data-hero-primary>
          <span data-hero-primary-label>Исследовать интересы</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--secondary" href={reg} data-reg-link data-placement="hero">
          Открыть Ventorme
        </a>
      </div>
      <p class="micro">Подборка доступна без регистрации</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(20px, 5vh, 60px));
    padding-bottom: clamp(40px, 7vh, 88px);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(56% 50% at 74% 40%, rgba(169, 192, 255, 0.09), transparent 70%),
      radial-gradient(30% 32% at 84% 66%, rgba(207, 251, 116, 0.05), transparent 70%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(18px, 3.4vh, 36px);
  }

  .hero-title {
    margin-top: 18px;
    max-width: 17ch;
    font-size: clamp(30px, 8.2vw, 42px);
  }

  .hero-lead {
    margin-top: 18px;
    max-width: 46ch;
    font-size: clamp(15.5px, 1.5vw, 18px);
  }

  .hero-stage {
    display: flex;
    min-height: 0;
    margin-inline: calc(var(--gutter) * -0.15);
  }

  .hero-actions {
    display: grid;
    gap: 10px;
    justify-items: start;
  }

  .hero-enter {
    animation: hero-enter var(--dur-hero) var(--ease-out) both;
  }

  .hero-enter--1 {
    animation-delay: 60ms;
  }

  .hero-enter--2 {
    animation-delay: 140ms;
  }

  .hero-enter--3 {
    animation-delay: 240ms;
  }

  .hero-enter--4 {
    animation-delay: 300ms;
  }

  .hero-enter--5 {
    animation-delay: 400ms;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(24px, 3vw, 48px);
      row-gap: 26px;
      align-items: start;
    }

    .hero-copy {
      grid-column: 1 / span 7;
      grid-row: 1;
    }

    .hero-title {
      font-size: clamp(44px, 5vw, 72px);
    }

    .hero-stage {
      grid-column: 8 / span 5;
      grid-row: 1 / span 2;
      align-self: stretch;
      min-height: 0;
      margin-inline: 0 calc(var(--gutter) * -0.35);
    }

    .hero-actions {
      grid-column: 1 / span 7;
      grid-row: 2;
    }
  }
</style>

<script>
  import { dispatchJourney, getJourney, subscribeJourney } from '../lib/journeyStore';
  import { readManualReducedMotion } from '../lib/motionPref';

  const LABELS: Record<string, string> = {
    initial: 'Исследовать интересы',
    questions: 'Продолжить подборку',
    result: 'Посмотреть мою подборку',
    demo: 'Посмотреть примеры',
  };

  const primary = document.querySelector('[data-hero-primary]');
  const label = document.querySelector('[data-hero-primary-label]');

  const syncLabel = (phase: string) => {
    if (!label) return;
    const text = LABELS[phase] ?? LABELS.initial;
    if (label.textContent !== text) label.textContent = text;
  };

  syncLabel(getJourney().phase);
  subscribeJourney((journey) => syncLabel(journey.phase));

  primary?.addEventListener('click', (event) => {
    event.preventDefault();
    dispatchJourney({ type: 'start' });
    const section = document.getElementById('interests');
    const heading = document.getElementById('interests-heading');
    const reduced =
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      readManualReducedMotion();
    section?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
    window.setTimeout(
      () => heading?.focus({ preventScroll: true }),
      reduced ? 60 : 520,
    );
  });
</script>
