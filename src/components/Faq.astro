---
const faq = [
  {
    question: 'Нужно уже знать, кем я хочу стать?',
    answer:
      'Нет. Подборка на этой странице помогает начать знакомство с направлениями. Выбор можно менять.',
  },
  {
    question: 'Это настоящий профориентационный тест?',
    answer:
      'Нет. Здесь короткая подборка по выбранным интересам. Она не заменяет полноценный тест. С возможностями профориентации можно познакомиться в Ventorme.',
  },
  {
    question: 'Где нужно регистрироваться?',
    answer: 'В Ventorme. Кнопки регистрации на этой странице ведут на платформу.',
  },
  {
    question: 'Что доступно без регистрации?',
    answer:
      'На этой странице — выбор интересов, направления для знакомства и небольшие задания. Условия функций Ventorme проверяй на самой платформе.',
  },
  {
    question: 'Сохранятся ли мои ответы в Ventorme?',
    answer:
      'В текущей версии ответы с этой страницы автоматически не передаются в аккаунт Ventorme.',
  },
  {
    question: 'А если мне подходят несколько направлений?',
    answer:
      'Это нормально. Начни с небольшого задания, сравни опыт и изучи другие варианты. Подборка не закрепляет за тобой одну профессию.',
  },
  {
    question: 'Зачем проходить начальную настройку?',
    answer:
      'Это часть начала работы в Ventorme: платформа подстраивается под тебя. Подробности — в самом продукте.',
  },
];
---

<section id="faq" class="section faq" aria-labelledby="faq-title">
  <div class="container">
    <div class="section-head">
      <h2 class="h2" id="faq-title">Частые вопросы</h2>
    </div>
    <div class="faq-list">
      {
        faq.map((item) => (
          <details class="faq-item" data-faq-item>
            <summary class="faq-question">
              <span class="faq-question-text">{item.question}</span>
              <span class="faq-icon" aria-hidden="true" />
            </summary>
            <div class="faq-answer">
              <div class="faq-answer-inner">
                <p>{item.answer}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-list {
    border-top: 1px solid var(--border);
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 44px;
    padding-block: 18px;
    cursor: pointer;
    list-style: none;
    font-size: clamp(17px, 1.8vw, 19px);
    font-weight: 600;
    color: var(--text);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::marker {
    content: '';
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    border-radius: 2px;
    background: var(--text-muted);
    transition:
      transform var(--dur-hover) var(--ease-out),
      background-color var(--dur-hover) var(--ease-out);
  }

  .faq-icon::before {
    left: 0;
    right: 0;
    top: 8px;
    height: 2px;
  }

  .faq-icon::after {
    top: 0;
    bottom: 0;
    left: 8px;
    width: 2px;
  }

  .faq-item[open] .faq-icon::before {
    background: var(--accent);
  }

  .faq-item[open] .faq-icon::after {
    transform: scaleY(0);
  }

  .faq-item::details-content {
    content-visibility: visible;
    visibility: visible;
    transition: visibility 220ms;
  }

  .faq-item:not([open])::details-content {
    visibility: hidden;
  }

  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 220ms var(--ease-out);
  }

  .faq-item[open] .faq-answer {
    grid-template-rows: 1fr;
  }

  .faq-answer-inner {
    overflow: hidden;
    min-height: 0;
  }

  .faq-answer-inner p {
    padding-bottom: 20px;
    color: var(--text-muted);
    max-width: 72ch;
  }
</style>

<script>
  import { track } from '../lib/events';

  document.querySelectorAll('[data-faq-item]').forEach((item, index) => {
    item.addEventListener('toggle', () => {
      if (item instanceof HTMLDetailsElement && item.open) {
        track('faq_open', { question: index + 1 });
      }
    });
  });
</script>
