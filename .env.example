# Режим выпуска: preview (по умолчанию) | competition
PUBLIC_VENTORME_MODE=preview

# Только для competition: официальный номер команды строкой (ведущие нули сохраняются).
# Пример заполнения при получении номера: PUBLIC_VENTORME_TEAM_ID=042
PUBLIC_VENTORME_TEAM_ID=

# База регистрации Ventorme. Менять только при отдельном решении команды.
PUBLIC_VENTORME_BASE=https://ventorme.ai/register
